{
  "name": "snips",
  "engines": {
    "vscode": "^1.11.0"
  },
  "contributes": {
    "snippets": [
      {
        "language": [
          "plaintext",
          "markdown",
          "tex",
          "html",
          "global"
        ],
        "path": "./snippets/global.json"
      },
      {
        "language": "c",
        "path": "./snippets/c.json"
      },
      {
        "language": "cpp",
        "path": "./snippets/cpp.json"
      },
      {
        "language": "lua",
        "path": "./snippets/lua.json"
      },
      {
        "language": "go",
        "path": "./snippets/go.json"
      },
      {
        "language": "rust",
        "path": "./snippets/rust.json"
      },
      {
        "language": [
          "markdown",
          "rmd"
        ],
        "path": "./snippets/markdown.json"
      },
      {
        "language": "python",
        "path": "./snippets/python/base.json"
      },
      {
        "language": "python",
        "path": "./snippets/python/comprehension.json"
      },
      {
        "language": "python",
        "path": "./snippets/python/debug.json"
      },
      {
        "language": "python",
        "path": "./snippets/python/python.json"
      },
      {
        "language": "python",
        "path": "./snippets/python/unittest.json"
      },
      {
        "language": "hcl",
        "path": "./snippets/hcl.json"
      },
      {
        "language": "pkl",
        "path": "./snippets/pkl.json"
      },
      {
        "language": "toml",
        "path": "./snippets/toml.json"
      }
    ]
  }
}
